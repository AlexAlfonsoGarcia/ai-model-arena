# Environment variables for AI Model Arena

# Primary provider for MVP - OpenRouter API key
OPENROUTER_API_KEY=

# OpenAI API key (for direct OpenAI provider)
OPENAI_API_KEY=

# Anthropic API key (for direct Anthropic provider)
ANTHROPIC_API_KEY=

# Google Generative AI API key (for direct Google Gemini provider)
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: future provider-specific keys (commented out for MVP)
# GOOGLE_GENERATIVE_AI_API_KEY=